{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "BAKELITE — App",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "windows": {
        "python": "${env:LOCALAPPDATA}\\Programs\\Python\\Python314\\python.exe"
      },
      "linux": {
        "python": "/usr/bin/python3"
      }
    },
    {
      "name": "BAKELITE — Supervisor (auto-reinicio)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/supervisor.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "windows": {
        "python": "${env:LOCALAPPDATA}\\Programs\\Python\\Python314\\python.exe"
      },
      "linux": {
        "python": "/usr/bin/python3"
      }
    }
  ]
}
